{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EyeUrAI",
  "version": "1.2.1",
  "identifier": "com.eyeurai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "EyeUrAI",
        "width": 430,
        "height": 680,
        "minWidth": 390,
        "minHeight": 520,
        "resizable": false,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "See every AI limit at a glance",
    "longDescription": "EyeUrAI is a local-first menu-bar monitor for AI subscription quotas and API credits.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NEMzNDYzMzNFQzVFMjkKUldRcFh1d3pZelJNRmFNZHprQ2N2cWw2OVJjMTBPS081djdrdE9jZnZERFkwZkg2RVQ0dUpJSFoK",
      "endpoints": [
        "https://github.com/itsnotmarvin/eyeurai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
